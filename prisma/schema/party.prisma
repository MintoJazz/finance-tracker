model Party {
    id Int @id @unique @default(autoincrement())

    name           String
    documentNumber String?
    phone          String?
    avatarUrl      String?
    birthDate      DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    auth Auth?

    contexts              ContextMember[]
    invitedContextMembers ContextMember[] @relation("ContextMemberInvitedBy")
}