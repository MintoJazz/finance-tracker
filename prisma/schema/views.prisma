view EntryCycleRuleView {
  entryId       Int
  cycleRuleId   Int
  agreementId   Int
  balanceId     Int
  referenceDate DateTime

  entry     Entry     @relation(fields: [entryId], references: [id])
  cycleRule CycleRule @relation(fields: [cycleRuleId], references: [id])

  @@unique([entryId, cycleRuleId])
  @@map("vw_entry_cycle_rule")
}

view EntryCategoryView {
  entryId           Int
  contextId         Int
  kind              String
  categoryBalanceId Int?
  creditBalanceId   Int?

  @@unique([entryId, contextId])
  @@map("vw_entry_category")
}