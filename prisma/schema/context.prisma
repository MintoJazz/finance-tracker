model FinancialContext {
    id        Int      @id @unique @default(autoincrement())

    name      String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    members ContextMember[]
    balances Balance[]
}

enum ContextMemberRole {
    OWNER
    ADMIN
    MEMBER
    DEPENDENT
}

enum ContextMemberStatus {
    PENDING
    ACTIVE
    REMOVED
}

model ContextMember {
    contextId        Int
    partyId          Int
    invitedByPartyId Int?

    role   ContextMemberRole
    status ContextMemberStatus @default(PENDING)

    invitedAt DateTime  @default(now())
    joinedAt  DateTime?
    removedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    financialContext FinancialContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
    party            Party            @relation(fields: [partyId], references: [id], onDelete: Cascade)
    invitedBy        Party?           @relation("ContextMemberInvitedBy", fields: [invitedByPartyId], references: [id])

    balance        MemberPosition[]

    @@id([contextId, partyId])
}
