enum CycleFrequency {
  ONCE
  WEEKLY
  MONTHLY
  YEARLY
}

enum BalanceType {
  WALLET
  CREDIT
  RESERVE
  CATEGORY
  PAYABLE
  RECEIVABLE
}

model Balance {
  id        Int  @id @default(autoincrement())
  parentId  Int?
  contextId Int

  name        String
  balanceType BalanceType

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  removedAt DateTime?

  parent           Balance?         @relation("BalanceTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Balance[]        @relation("BalanceTree")
  financialContext FinancialContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  agreement  Agreement?
  appearance BalanceAppearance?
  movements  Movement[]

  @@unique([id, contextId, balanceType])
}

model Agreement {
  balanceId Int @id

  includeInProjection Boolean        @default(true)
  frequency           CycleFrequency @default(MONTHLY)
  interval            Int            @default(1)

  startsAt  DateTime  @db.Date
  endsAt    DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  balance       Balance                @relation(fields: [balanceId], references: [id], onDelete: Restrict)
  rules         CycleRule[]
  amountEntries AgreementAmountEntry[]
}

model CycleRule {
  id          Int @id @default(autoincrement())
  agreementId Int

  dueDay       Int
  dueMonth     Int?
  closingDay   Int?
  closingMonth Int?

  effectiveFrom DateTime @db.Date
  createdAt     DateTime @default(now())

  agreement           Agreement            @relation(fields: [agreementId], references: [balanceId], onDelete: Restrict)
  entryCycleRuleViews EntryCycleRuleView[]

  @@unique([agreementId, effectiveFrom])
  @@index([agreementId])
}

model AgreementAmountEntry {
  id          Int      @id @default(autoincrement())
  agreementId Int
  amount      Int
  effectiveAt DateTime
  reason      String?
  createdAt   DateTime @default(now())

  agreement Agreement @relation(fields: [agreementId], references: [balanceId], onDelete: Restrict)

  @@index([agreementId, effectiveAt])
}

model BalanceAppearance {
  balanceId Int @id

  icon  String?
  color String?

  balance Balance @relation(fields: [balanceId], references: [id], onDelete: Cascade)
}
