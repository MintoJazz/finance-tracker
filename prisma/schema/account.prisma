enum CycleFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum BalanceType {
  WALLET
  CREDIT
  RESERVE
  CATEGORY
  COMMITMENT
  RECEIVABLE
  PAYABLE
}

model Balance {
  id          Int         @id @default(autoincrement())
  contextId   Int
  name        String
  balanceType BalanceType
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  removedAt   DateTime?

  financialContext FinancialContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  agreement        Agreement?
  movements        Movement[]
}

model Agreement {
  id                  Int       @id @default(autoincrement())
  balanceId           Int       @unique
  includeInProjection Boolean   @default(true)
  startsAt            DateTime  @db.Date
  endsAt              DateTime? @db.Date
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  balance       Balance                @relation(fields: [balanceId], references: [id], onDelete: Restrict)
  rules         CycleRule[]
  amountEntries AgreementAmountEntry[]
}

model CycleRule {
  id            Int            @id @default(autoincrement())
  agreementId   Int
  effectiveFrom DateTime       @db.Date
  frequency     CycleFrequency @default(MONTHLY)
  interval      Int            @default(1)
  closingDay    Int?
  dueDay        Int
  createdAt     DateTime       @default(now())

  agreement           Agreement            @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  entryCycleRuleViews EntryCycleRuleView[] // <-- ADICIONAR ESTA LINHA

  @@unique([agreementId, effectiveFrom])
  @@index([agreementId])
}

/// Log append-only de ajustes (deltas, em centavos) do valor de um Agreement.
/// Valor vigente em uma data = max(0, soma dos amount com effectiveAt <= data).
/// Semântica por Balance.balanceType:
///   CREDIT                         -> limite do cartão
///   COMMITMENT | PAYABLE | RECEIVABLE -> valor esperado por ciclo do compromisso
model AgreementAmountEntry {
  id          Int      @id @default(autoincrement())
  agreementId Int
  amount      Int
  effectiveAt DateTime
  reason      String?
  createdAt   DateTime @default(now())

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)

  @@index([agreementId, effectiveAt])
}

