enum EntryType {
  DIRECT
  TRANSFER

  ACCRUAL
  CLAIM_OPENING

  SETTLEMENT
  CLAIM_PAYMENT
  CLAIM_RECEIPT

  ADJUSTMENT

  REVERSAL
}

enum MovementDirection {
  CREDIT
  DEBIT
}

model Entry {
  id              Int       @id @default(autoincrement())
  description     String
  type            EntryType
  reversesEntryId Int?      @unique
  dueDate         DateTime
  competanceDate  DateTime?
  createdAt       DateTime  @default(now())

  /// Balance (`INSTALLMENT`) que agrupa as parcelas de uma mesma compra. Nulo nos demais lançamentos.
  installmentId     Int?
  /// Posição da parcela na compra (1..N). Preenchido junto com `installmentId`.
  installmentNumber Int?

  reverses            Entry?               @relation("EntryReversal", fields: [reversesEntryId], references: [id])
  reversedBy          Entry?               @relation("EntryReversal")
  installment         Balance?             @relation("EntryInstallment", fields: [installmentId], references: [id], onDelete: Restrict)
  movements           Movement[]
  entryCycleRuleViews EntryCycleRuleView[] // <-- ADICIONAR ESTA LINHA

  @@unique([installmentId, installmentNumber])
  @@index([installmentId])
}

model Movement {
  id        Int               @id @default(autoincrement())
  entryId   Int
  balanceId Int
  amount    Int
  direction MovementDirection

  entry   Entry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  balance Balance @relation(fields: [balanceId], references: [id], onDelete: Restrict)

  @@index([balanceId])
  @@index([entryId])
}
