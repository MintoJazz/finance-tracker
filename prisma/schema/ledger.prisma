enum EntryType {
  DIRECT
  TRANSFER

  ACCRUAL
  CLAIM_OPENING

  SETTLEMENT
  CLAIM_PAYMENT
  CLAIM_RECEIPT

  ADJUSTMENT
  CLAIM_ACCEPTANCE

  REVERSAL
}

enum MovementDirection {
  CREDIT
  DEBIT
}

model Entry {
  id              Int       @id @default(autoincrement())
  description     String
  type            EntryType
  reversesEntryId Int?      @unique
  dueDate         DateTime
  competanceDate  DateTime?
  createdAt       DateTime  @default(now())

  reverses            Entry?               @relation("EntryReversal", fields: [reversesEntryId], references: [id])
  reversedBy          Entry?               @relation("EntryReversal")
  movements           Movement[]
  entryCycleRuleViews EntryCycleRuleView[] // <-- ADICIONAR ESTA LINHA
}

model Movement {
  id        Int               @id @default(autoincrement())
  entryId   Int
  balanceId Int
  amount    Int
  direction MovementDirection

  entry   Entry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  balance Balance @relation(fields: [balanceId], references: [id], onDelete: Restrict)

  @@index([balanceId])
}
