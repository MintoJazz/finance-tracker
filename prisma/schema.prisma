generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionStatus {
  PROJECTED
  PENDING
  SETTLED
  CANCELED
}

enum MovementRole {
  DEBIT
  CREDIT
  TRANSFER_CREDIT
  TRANSFER_DEBIT
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

model User {
  id   Int    @id @default(autoincrement())
  name String
}