generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BucketType {
  WALLET
  CREDIT
  RESERVE
}

enum TransactionStatus {
  PROJECTED
  PENDING
  SETTLED
  CANCELED
}

enum MovementRole {
  DEBIT
  CREDIT
  TRANSFER_CREDIT
  TRANSFER_DEBIT
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

model User {
  id   Int    @id @default(autoincrement())
  name String

  buckets Bucket[]
}

model Bucket {
  id     Int @id @default(autoincrement())
  userId Int

  name String
  type BucketType

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  movements Movement[]
}

model Transaction {
  id          Int @id @default(autoincrement())

  description String
  amount      Int
  date        DateTime

  status TransactionStatus @default(PROJECTED)
  type   TransactionType

  movements Movement[]
}

model Movement {
  id            Int @id @default(autoincrement())
  bucketId      Int
  transactionId Int

  amount Int
  role   MovementRole

  bucket      Bucket      @relation(fields: [bucketId], references: [id], onDelete: Restrict)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}
